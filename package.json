{
  "name": "readOnBush",
  "displayName": "Read On Bush",
  "description": "在 VS Code 状态栏或终端伪装窗口低调阅读 txt / epub / pdf 小说，支持书架导入/目录批量导入、分类与目录分组、进度跳转、PDF 图片预览、快捷键模式切换和阅读体验配置；导入 mobi/azw3 时引导前往 CloudConvert 转 epub。",
  "version": "2.4.0",
  "publisher": "moyuderen",
  "author": {
    "name": "moyuderen",
    "email": "moyuderen.git@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/moyuderen/read-on-bush"
  },
  "bugs": {
    "url": "https://github.com/moyuderen/read-on-bush/issues",
    "email": "moyuderen.git@gmail.com"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "read",
    "阅读",
    "小说",
    "epub",
    "pdf",
    "摸鱼",
    "vscode 状态栏",
    "终端伪装"
  ],
  "icon": "public/moyu.png",
  "activationEvents": [
    "onView:bookList",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Read On Bush",
      "properties": {
        "readOnBush.lineWidth": {
          "type": "number",
          "default": 45,
          "minimum": 10,
          "maximum": 200,
          "description": "每个阅读片段的最大字符数"
        },
        "readOnBush.defaultReadingMode": {
          "type": "boolean",
          "default": true,
          "description": "是否默认启用阅读快捷键"
        },
        "readOnBush.autoRefreshBookList": {
          "type": "boolean",
          "default": false,
          "description": "是否尝试自动刷新书架"
        },
        "readOnBush.statusBarPrefix": {
          "type": "string",
          "default": "",
          "description": "状态栏内容前缀"
        },
        "readOnBush.showProgress": {
          "type": "boolean",
          "default": true,
          "description": "是否显示阅读进度"
        },
        "readOnBush.displayTarget": {
          "type": "string",
          "default": "statusBar",
          "enum": [
            "statusBar",
            "terminalCamouflage",
            "both"
          ],
          "enumDescriptions": [
            "仅在状态栏显示",
            "仅在终端伪装中显示",
            "同时在状态栏和终端伪装中显示"
          ],
          "description": "阅读内容显示位置"
        },
        "readOnBush.terminalCamouflageLineWidth": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 200,
          "description": "终端伪装中每行正文的最大显示宽度。设置为 0 时根据终端宽度自动计算"
        },
        "readOnBush.terminalCamouflageLineCount": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "终端伪装中展示的正文行数"
        },
        "readOnBush.terminalCamouflageStyle": {
          "type": "string",
          "default": "claudeCli",
          "enum": [
            "buildLog",
            "claudeCli",
            "serverLog",
            "vite",
            "docker",
            "custom"
          ],
          "enumDescriptions": [
            "构建/Watch 日志样式",
            "Claude Code CLI 风格",
            "后端服务日志样式",
            "Vite 开发服务器样式",
            "Docker Compose 日志样式",
            "使用自定义 JSON 模板"
          ],
          "description": "终端伪装的输出样式"
        },
        "readOnBush.terminalCamouflageCustomTemplate": {
          "type": [
            "object",
            "null"
          ],
          "default": null,
          "description": "自定义终端伪装模板，仅在 terminalCamouflageStyle 为 custom 时生效。建议使用“Read On Bush: 配置自定义终端模板”生成",
          "required": [
            "version",
            "terminalName",
            "contentPrefix",
            "header",
            "trailing",
            "done",
            "debugContent"
          ],
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "number",
              "enum": [
                1
              ],
              "description": "模板格式版本"
            },
            "terminalName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "终端标签名称"
            },
            "contentPrefix": {
              "type": "string",
              "maxLength": 100,
              "description": "阅读正文首行前缀"
            },
            "header": {
              "type": "array",
              "maxItems": 100,
              "description": "阅读正文前显示的日志行",
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 1000
                  },
                  {
                    "type": "object",
                    "required": [
                      "text"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "text": {
                        "type": "string",
                        "maxLength": 1000
                      },
                      "style": {
                        "type": "string",
                        "enum": [
                          "plain",
                          "dim",
                          "red",
                          "green",
                          "yellow",
                          "blue",
                          "magenta",
                          "cyan"
                        ]
                      }
                    }
                  }
                ]
              }
            },
            "trailing": {
              "type": "array",
              "maxItems": 100,
              "description": "阅读正文后显示的日志行",
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 1000
                  },
                  {
                    "type": "object",
                    "required": [
                      "text"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "text": {
                        "type": "string",
                        "maxLength": 1000
                      },
                      "style": {
                        "type": "string",
                        "enum": [
                          "plain",
                          "dim",
                          "red",
                          "green",
                          "yellow",
                          "blue",
                          "magenta",
                          "cyan"
                        ]
                      }
                    }
                  }
                ]
              }
            },
            "done": {
              "description": "完成/进度行，text 中仅支持 {{progress}} 占位符",
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 1000
                },
                {
                  "type": "object",
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "maxLength": 1000
                    },
                    "style": {
                      "type": "string",
                      "enum": [
                        "plain",
                        "dim",
                        "red",
                        "green",
                        "yellow",
                        "blue",
                        "magenta",
                        "cyan"
                      ]
                    }
                  }
                }
              ]
            },
            "debugContent": {
              "type": "array",
              "maxItems": 100,
              "description": "快速隐藏或调试模式中显示的伪装正文",
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 1000
                  },
                  {
                    "type": "object",
                    "required": [
                      "text"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "text": {
                        "type": "string",
                        "maxLength": 1000
                      },
                      "style": {
                        "type": "string",
                        "enum": [
                          "plain",
                          "dim",
                          "red",
                          "green",
                          "yellow",
                          "blue",
                          "magenta",
                          "cyan"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "readOnBush.bookListGroupBy": {
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "category",
            "directory"
          ],
          "enumDescriptions": [
            "不分组",
            "按分类分组",
            "按文件目录分组"
          ],
          "description": "书架分组方式"
        }
      }
    },
    "commands": [
      {
        "command": "readOnBush.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "readOnBush.switchReadingMode",
        "title": "快捷键激活",
        "category": "Read On Bush",
        "icon": "",
        "shortTitle": "激活阅读快捷键"
      },
      {
        "command": "readOnBush.switchCodingMode",
        "title": "快捷键禁用",
        "category": "Read On Bush",
        "icon": "",
        "shortTitle": "禁用阅读快捷键"
      },
      {
        "command": "readOnBush.prev",
        "title": "状态栏读书：上一行"
      },
      {
        "command": "readOnBush.next",
        "title": "状态栏读书：下一行"
      },
      {
        "command": "readOnBush.jump",
        "title": "状态栏读书：跳转"
      },
      {
        "command": "readOnBush.openTerminalCamouflage",
        "title": "打开终端伪装",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.toggleTerminalCamouflage",
        "title": "切换终端伪装",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.openCustomTemplateEditor",
        "title": "配置自定义终端模板",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.deleteEntry",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "readOnBush.renameBook",
        "title": "Rename",
        "icon": "$(edit)"
      },
      {
        "command": "readOnBush.setBookCategory",
        "title": "Set Category",
        "icon": "$(tag)"
      },
      {
        "command": "readOnBush.clearBookCategory",
        "title": "Clear Category",
        "icon": "$(clear-all)"
      },
      {
        "command": "readOnBush.import",
        "title": "Import",
        "icon": "$(add)"
      },
      {
        "command": "readOnBush.importDirectory",
        "title": "Import Directory",
        "icon": "$(folder-opened)"
      },
      {
        "command": "readOnBush.refreshBookList",
        "title": "Refresh",
        "icon": "$(search-refresh)"
      },
      {
        "command": "readOnBush.sortBookList",
        "title": "Sort",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "readOnBush.switchBookListGroupBy",
        "title": "Group By",
        "icon": "$(list-tree)"
      },
      {
        "command": "readOnBush.epub.next",
        "title": "EPUB 读书：下一页",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.epub.prev",
        "title": "EPUB 读书：上一页",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.epub.jumpChapter",
        "title": "EPUB 读书：跳转章节",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.epub.stop",
        "title": "EPUB 读书：停止",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.epub.viewImage",
        "title": "EPUB 读书：查看图片",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.pdf.next",
        "title": "PDF 读书：下一页",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.pdf.prev",
        "title": "PDF 读书：上一页",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.pdf.jumpPage",
        "title": "PDF 读书：跳转页面",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.pdf.stop",
        "title": "PDF 读书：停止",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.pdf.viewImage",
        "title": "PDF 读书：查看图片",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.openBookOutline",
        "title": "Open Book Outline",
        "icon": "$(bookmark)"
      }
    ],
    "keybindings": [
      {
        "command": "readOnBush.prev",
        "key": "ctrl+left",
        "mac": "cmd+left",
        "when": "readOnBush.isReadingMode == true"
      },
      {
        "command": "readOnBush.next",
        "key": "ctrl+right",
        "mac": "cmd+right",
        "when": "readOnBush.isReadingMode == true"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "readOnBush",
          "title": "Read On Bush",
          "icon": "public/logo.svg"
        }
      ]
    },
    "views": {
      "readOnBush": [
        {
          "id": "bookList",
          "name": "书架"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "content",
        "contents": "[Hello World](command:readOnBush.helloWorld)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "readOnBush.deleteEntry",
          "group": "inline",
          "when": "view == bookList && viewItem == book"
        },
        {
          "command": "readOnBush.renameBook",
          "group": "inline",
          "when": "view == bookList && viewItem == book"
        },
        {
          "command": "readOnBush.setBookCategory",
          "group": "book@1",
          "when": "view == bookList && viewItem == book"
        },
        {
          "command": "readOnBush.clearBookCategory",
          "group": "book@2",
          "when": "view == bookList && viewItem == book"
        }
      ],
      "view/title": [
        {
          "command": "readOnBush.import",
          "group": "navigation@1",
          "when": "view == bookList"
        },
        {
          "command": "readOnBush.importDirectory",
          "group": "navigation@2",
          "when": "view == bookList"
        },
        {
          "command": "readOnBush.refreshBookList",
          "group": "navigation",
          "when": "view == bookList"
        },
        {
          "command": "readOnBush.sortBookList",
          "group": "navigation",
          "when": "view == bookList"
        },
        {
          "command": "readOnBush.switchBookListGroupBy",
          "group": "navigation",
          "when": "view == bookList"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "linebyline": "^1.3.0",
    "pdfjs-dist": "^3.11.174",
    "pngjs": "^7.0.0"
  }
}
