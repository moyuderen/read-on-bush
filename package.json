{
  "name": "readOnBush",
  "displayName": "Read On Bush",
  "description": "在 VS Code 中低调摸鱼看小说——状态栏或终端伪装窗口阅读 TXT / EPUB / PDF，内置书架管理、章节目录、进度跳转与快捷键模式。",
  "version": "2.9.0",
  "publisher": "moyuderen",
  "author": {
    "name": "moyuderen",
    "email": "moyuderen.git@gmail.com"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/moyuderen/read-on-bush",
  "repository": {
    "type": "git",
    "url": "https://github.com/moyuderen/read-on-bush"
  },
  "bugs": {
    "url": "https://github.com/moyuderen/read-on-bush/issues",
    "email": "moyuderen.git@gmail.com"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "小说",
    "小说阅读器",
    "小说插件",
    "摸鱼",
    "摸鱼神器",
    "上班摸鱼",
    "偷看",
    "电子书",
    "电子书阅读器",
    "看书",
    "读书",
    "阅读",
    "伪装",
    "txt",
    "epub",
    "pdf",
    "ebook",
    "novel",
    "fiction",
    "txt reader",
    "epub reader",
    "pdf reader",
    "ebook reader",
    "novel reader",
    "stealth reading",
    "camouflage",
    "bookshelf",
    "终端伪装",
    "状态栏"
  ],
  "icon": "public/moyu.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Read On Bush",
      "properties": {
        "readOnBush.lineWidth": {
          "type": "number",
          "default": 45,
          "minimum": 10,
          "maximum": 200,
          "description": "每个阅读片段的最大字符数"
        },
        "readOnBush.txtEncoding": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "utf-8",
            "utf-16le",
            "utf-16be",
            "gb18030"
          ],
          "enumDescriptions": [
            "自动检测 BOM 和常见无 BOM UTF-16；歧义时按 UTF-8 读取",
            "UTF-8",
            "UTF-16 Little Endian",
            "UTF-16 Big Endian",
            "GB18030/GBK（适用于常见 Windows 中文 TXT）"
          ],
          "description": "TXT 文件编码；自动检测无法正确识别时可手动指定"
        },
        "readOnBush.defaultReadingMode": {
          "type": "boolean",
          "default": true,
          "description": "是否默认启用阅读快捷键"
        },
        "readOnBush.privacyDisplayOnStart": {
          "type": "boolean",
          "default": false,
          "description": "激活扩展时是否默认开启隐私界面模式"
        },
        "readOnBush.autoRefreshBookList": {
          "type": "boolean",
          "default": false,
          "description": "是否尝试自动刷新书架"
        },
        "readOnBush.statusBarPrefix": {
          "type": "string",
          "default": "",
          "description": "状态栏内容前缀"
        },
        "readOnBush.showProgress": {
          "type": "boolean",
          "default": true,
          "description": "是否显示阅读进度"
        },
        "readOnBush.showChapterTitle": {
          "type": "boolean",
          "default": true,
          "description": "是否在终端伪装的阅读进度中显示章节名称"
        },
        "readOnBush.imagePreviewMode": {
          "type": "string",
          "default": "thumbnail",
          "enum": [
            "thumbnail",
            "large"
          ],
          "enumDescriptions": [
            "先显示缩略图，点击图片后放大",
            "打开时直接显示大图"
          ],
          "description": "EPUB/PDF 图片预览的初始显示模式"
        },
        "readOnBush.displayTarget": {
          "type": "string",
          "default": "statusBar",
          "enum": [
            "statusBar",
            "terminalCamouflage"
          ],
          "enumDescriptions": [
            "仅在状态栏显示",
            "仅在终端伪装中显示"
          ],
          "description": "阅读内容显示位置"
        },
        "readOnBush.camouflageSurface": {
          "type": "string",
          "default": "terminal",
          "enum": [
            "terminal",
            "readerPanel"
          ],
          "enumDescriptions": [
            "集成终端（Pseudoterminal）",
            "阅读面板（Webview Panel）"
          ],
          "description": "伪装阅读内容的显示载体（终端或阅读面板）。可随时切换，立即生效"
        },
        "readOnBush.terminalCamouflageLineWidth": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 200,
          "description": "终端伪装中每行正文的最大显示宽度。设置为 0 时根据终端宽度自动计算"
        },
        "readOnBush.terminalCamouflageLineCount": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "终端伪装中展示的正文行数"
        },
        "readOnBush.terminalCamouflageStyle": {
          "type": "string",
          "default": "claudeCli",
          "enum": [
            "buildLog",
            "claudeCli",
            "serverLog",
            "vite",
            "docker",
            "custom"
          ],
          "enumDescriptions": [
            "构建/Watch 日志样式",
            "Claude Code CLI 风格",
            "后端服务日志样式",
            "Vite 开发服务器样式",
            "Docker Compose 日志样式",
            "使用自定义 JSON 模板"
          ],
          "description": "终端伪装的输出样式"
        },
        "readOnBush.terminalCamouflageCustomTemplate": {
          "type": [
            "object",
            "null"
          ],
          "default": null,
          "description": "自定义终端伪装模板，仅在 terminalCamouflageStyle 为 custom 时生效。建议使用“Read On Bush: 配置自定义终端模板”生成",
          "required": [
            "version",
            "terminalName",
            "contentPrefix",
            "header",
            "trailing",
            "done",
            "debugContent"
          ],
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "number",
              "enum": [
                1
              ],
              "description": "模板格式版本"
            },
            "terminalName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "终端标签名称"
            },
            "contentPrefix": {
              "type": "string",
              "maxLength": 100,
              "description": "阅读正文首行前缀"
            },
            "header": {
              "type": "array",
              "maxItems": 100,
              "description": "阅读正文前显示的日志行",
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 1000
                  },
                  {
                    "type": "object",
                    "required": [
                      "text"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "text": {
                        "type": "string",
                        "maxLength": 1000
                      },
                      "style": {
                        "type": "string",
                        "enum": [
                          "plain",
                          "dim",
                          "red",
                          "green",
                          "yellow",
                          "blue",
                          "magenta",
                          "cyan"
                        ]
                      }
                    }
                  }
                ]
              }
            },
            "trailing": {
              "type": "array",
              "maxItems": 100,
              "description": "阅读正文后显示的日志行",
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 1000
                  },
                  {
                    "type": "object",
                    "required": [
                      "text"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "text": {
                        "type": "string",
                        "maxLength": 1000
                      },
                      "style": {
                        "type": "string",
                        "enum": [
                          "plain",
                          "dim",
                          "red",
                          "green",
                          "yellow",
                          "blue",
                          "magenta",
                          "cyan"
                        ]
                      }
                    }
                  }
                ]
              }
            },
            "done": {
              "description": "完成/进度行，text 中仅支持 {{progress}} 占位符",
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 1000
                },
                {
                  "type": "object",
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "maxLength": 1000
                    },
                    "style": {
                      "type": "string",
                      "enum": [
                        "plain",
                        "dim",
                        "red",
                        "green",
                        "yellow",
                        "blue",
                        "magenta",
                        "cyan"
                      ]
                    }
                  }
                }
              ]
            },
            "debugContent": {
              "type": "array",
              "maxItems": 100,
              "description": "快速隐藏或调试模式中显示的伪装正文",
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 1000
                  },
                  {
                    "type": "object",
                    "required": [
                      "text"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "text": {
                        "type": "string",
                        "maxLength": 1000
                      },
                      "style": {
                        "type": "string",
                        "enum": [
                          "plain",
                          "dim",
                          "red",
                          "green",
                          "yellow",
                          "blue",
                          "magenta",
                          "cyan"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "readOnBush.bookListGroupBy": {
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "category",
            "directory"
          ],
          "enumDescriptions": [
            "不分组",
            "按分类分组",
            "按文件目录分组"
          ],
          "description": "书架分组方式"
        },
        "readOnBush.recentBookCount": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "maximum": 50,
          "description": "书架顶部「最近阅读」分组显示的书籍数量；设置为 0 表示禁用"
        },
        "readOnBush.cacheLimitMB": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "maximum": 10000,
          "description": "EPUB/PDF 解析缓存上限（MB）。超过后自动按 LRU 淘汰最旧缓存；设置为 0 表示不限制"
        },
        "readOnBush.autoTurnSpeed": {
          "type": "number",
          "default": 450,
          "minimum": 1,
          "maximum": 9999,
          "description": "自动翻页的阅读速度（字符/分钟）。阅读中按 a 键启动自动翻页后，按此速度估算每页停留时间"
        },
        "readOnBush.autoTurnMinSeconds": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 600,
          "description": "自动翻页每页最短停留秒数（按字数估算模式下生效）"
        },
        "readOnBush.autoTurnMaxSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 600,
          "description": "自动翻页每页最长停留秒数（按字数估算模式下生效）"
        },
        "readOnBush.autoTurnFixedSeconds": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 600,
          "description": "自动翻页每页固定停留秒数。设置为 0 时按字数估算；大于 0 时完全覆盖按字数计算"
        }
      }
    },
    "commands": [
      {
        "command": "readOnBush.switchReadingMode",
        "title": "快捷键激活",
        "category": "Read On Bush",
        "icon": "",
        "shortTitle": "激活阅读快捷键"
      },
      {
        "command": "readOnBush.switchCodingMode",
        "title": "快捷键禁用",
        "category": "Read On Bush",
        "icon": "",
        "shortTitle": "禁用阅读快捷键"
      },
      {
        "command": "readOnBush.prev",
        "title": "状态栏读书：上一行"
      },
      {
        "command": "readOnBush.next",
        "title": "状态栏读书：下一行"
      },
      {
        "command": "readOnBush.jump",
        "title": "状态栏读书：跳转"
      },
      {
        "command": "readOnBush.openTerminalCamouflage",
        "title": "打开终端伪装",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.toggleTerminalCamouflage",
        "title": "切换终端伪装",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.openCustomTemplateEditor",
        "title": "配置自定义终端模板",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.deleteEntry",
        "title": "删除书籍",
        "icon": "$(trash)"
      },
      {
        "command": "readOnBush.renameBook",
        "title": "重命名书籍",
        "icon": "$(edit)"
      },
      {
        "command": "readOnBush.setBookCategory",
        "title": "设置分类",
        "icon": "$(tag)"
      },
      {
        "command": "readOnBush.clearBookCategory",
        "title": "清除分类",
        "icon": "$(clear-all)"
      },
      {
        "command": "readOnBush.setPrivacyAlias",
        "title": "设置隐私别名",
        "icon": "$(eye)"
      },
      {
        "command": "readOnBush.togglePrivacyDisplay",
        "title": "切换隐私界面",
        "icon": "$(eye)"
      },
      {
        "command": "readOnBush.enablePrivacyDisplay",
        "title": "开启隐私界面",
        "icon": "$(eye)"
      },
      {
        "command": "readOnBush.disablePrivacyDisplay",
        "title": "关闭隐私界面",
        "icon": "$(eye-closed)"
      },
      {
        "command": "readOnBush.createCategory",
        "title": "新建分类",
        "icon": "$(new-folder)"
      },
      {
        "command": "readOnBush.renameCategory",
        "title": "重命名分类",
        "icon": "$(edit)"
      },
      {
        "command": "readOnBush.import",
        "title": "导入书籍",
        "icon": "$(add)"
      },
      {
        "command": "readOnBush.importDirectory",
        "title": "导入目录",
        "icon": "$(folder)"
      },
      {
        "command": "readOnBush.refreshBookList",
        "title": "刷新书架",
        "icon": "$(search-refresh)"
      },
      {
        "command": "readOnBush.sortBookList",
        "title": "排序书架",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "readOnBush.switchBookListGroupBy",
        "title": "分组方式",
        "icon": "$(group-by-ref-type)"
      },
      {
        "command": "readOnBush.searchBook",
        "title": "搜索书籍",
        "icon": "$(search)"
      },
      {
        "command": "readOnBush.searchCurrentBook",
        "title": "搜索当前书籍全文",
        "category": "Read On Bush",
        "icon": "$(search)"
      },
      {
        "command": "readOnBush.searchBack",
        "title": "返回搜索前位置",
        "category": "Read On Bush",
        "icon": "$(arrow-left)"
      },
      {
        "command": "readOnBush.epub.next",
        "title": "EPUB 读书：下一页",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.epub.prev",
        "title": "EPUB 读书：上一页",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.epub.jumpChapter",
        "title": "EPUB 读书：跳转章节",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.epub.stop",
        "title": "EPUB 读书：停止",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.epub.viewImage",
        "title": "EPUB 读书：查看图片",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.pdf.next",
        "title": "PDF 读书：下一页",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.pdf.prev",
        "title": "PDF 读书：上一页",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.pdf.jumpPage",
        "title": "PDF 读书：跳转页面",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.pdf.stop",
        "title": "PDF 读书：停止",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.pdf.viewImage",
        "title": "PDF 读书：查看图片",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.openBook",
        "title": "打开书籍",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.openBookOutline",
        "title": "打开书籍目录",
        "icon": "$(bookmark)"
      },
      {
        "command": "readOnBush.clearCache",
        "title": "清除全部缓存",
        "category": "Read On Bush",
        "icon": "$(trash)"
      },
      {
        "command": "readOnBush.continueReading",
        "title": "继续阅读",
        "category": "Read On Bush"
      },
      {
        "command": "readOnBush.removeFromRecent",
        "title": "从最近阅读中移除",
        "category": "Read On Bush",
        "icon": "$(close)"
      },
      {
        "command": "readOnBush.autoTurn.toggle",
        "title": "切换自动翻页",
        "category": "Read On Bush"
      }
    ],
    "keybindings": [
      {
        "command": "readOnBush.prev",
        "key": "ctrl+left",
        "mac": "cmd+left",
        "when": "readOnBush.isReadingMode == true && readOnBush.isTxtReading == true"
      },
      {
        "command": "readOnBush.next",
        "key": "ctrl+right",
        "mac": "cmd+right",
        "when": "readOnBush.isReadingMode == true && readOnBush.isTxtReading == true"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "readOnBush",
          "title": "Read On Bush",
          "icon": "public/logo.svg"
        }
      ],
      "panel": [
        {
          "id": "readOnBush-readerPanel",
          "title": "Read On Bush",
          "icon": "public/logo.svg"
        }
      ]
    },
    "views": {
      "readOnBush": [
        {
          "id": "readOnBush-bookList",
          "name": "书架",
          "icon": "public/logo.svg"
        }
      ],
      "readOnBush-readerPanel": [
        {
          "type": "webview",
          "id": "readOnBush-readerView",
          "name": "阅读",
          "icon": "public/logo.svg"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "readOnBush.deleteEntry",
          "group": "inline",
          "when": "view == readOnBush-bookList && viewItem =~ /^(book|recentBook)$/"
        },
        {
          "command": "readOnBush.renameBook",
          "group": "inline",
          "when": "view == readOnBush-bookList && viewItem =~ /^(book|recentBook)$/"
        },
        {
          "command": "readOnBush.setBookCategory",
          "group": "book@1",
          "when": "view == readOnBush-bookList && viewItem =~ /^(book|recentBook)$/"
        },
        {
          "command": "readOnBush.clearBookCategory",
          "group": "book@2",
          "when": "view == readOnBush-bookList && viewItem =~ /^(book|recentBook)$/"
        },
        {
          "command": "readOnBush.setPrivacyAlias",
          "group": "book@3",
          "when": "view == readOnBush-bookList && viewItem =~ /^(book|recentBook)$/"
        },
        {
          "command": "readOnBush.renameCategory",
          "group": "inline",
          "when": "view == readOnBush-bookList && viewItem == categoryGroup"
        },
        {
          "command": "readOnBush.removeFromRecent",
          "group": "inline",
          "when": "view == readOnBush-bookList && viewItem == recentBook"
        }
      ],
      "view/title": [
        {
          "command": "readOnBush.searchBook",
          "group": "navigation@0",
          "when": "view == readOnBush-bookList"
        },
        {
          "command": "readOnBush.import",
          "group": "navigation@1",
          "when": "view == readOnBush-bookList"
        },
        {
          "command": "readOnBush.importDirectory",
          "group": "navigation@2",
          "when": "view == readOnBush-bookList"
        },
        {
          "command": "readOnBush.refreshBookList",
          "group": "navigation",
          "when": "view == readOnBush-bookList"
        },
        {
          "command": "readOnBush.enablePrivacyDisplay",
          "group": "navigation@3",
          "when": "view == readOnBush-bookList && readOnBush.isPrivacyDisplay != true"
        },
        {
          "command": "readOnBush.disablePrivacyDisplay",
          "group": "navigation@3",
          "when": "view == readOnBush-bookList && readOnBush.isPrivacyDisplay == true"
        },
        {
          "command": "readOnBush.sortBookList",
          "group": "navigation",
          "when": "view == readOnBush-bookList"
        },
        {
          "command": "readOnBush.switchBookListGroupBy",
          "group": "navigation",
          "when": "view == readOnBush-bookList"
        },
        {
          "command": "readOnBush.createCategory",
          "group": "navigation",
          "when": "view == readOnBush-bookList"
        }
      ]
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "vscode:prepublish": "npm run rebuild",
    "compile": "tsc -p ./",
    "rebuild": "npm run clean && npm run compile",
    "typecheck": "tsc --noEmit -p ./",
    "package": "vsce package",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run rebuild && npm run lint",
